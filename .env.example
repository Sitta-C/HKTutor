# HKTutor shared development/demo project
# Copy this file to .env, replace every bracketed placeholder locally, and never commit .env.

# Prisma/NestJS database connection for S1-T04. Use the Supavisor session-mode URL (port 5432).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[DB_REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Server-only Supabase access for later API/Storage work. Never expose the secret to Next.js.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_[REPLACE_ME]"

# Seed-only mapping for a pre-provisioned Clerk administrator in the shared development/demo project.
# Public onboarding must never create an administrator.
SEED_ADMIN_CLERK_USER_ID="[ADMIN_CLERK_USER_ID]"
SEED_ADMIN_EMAIL="[ADMIN_EMAIL]"

# Seed-only mapping for a pre-provisioned Clerk tutor used by development/demo fixtures.
SEED_TUTOR_CLERK_USER_ID="[TUTOR_CLERK_USER_ID]"
SEED_TUTOR_EMAIL="[TUTOR_EMAIL]"

# Clerk key
CLERK_SECRET_KEY="[CLERK_SECRET_KEY]"
CLERK_PUBLISHABLE_KEY="[CLERK_PUBLISHABLE_KEY]"

# Public base URL of the NestJS API. The web client bakes this into its production build
# (compose build arg → web Dockerfile ARG/ENV before `next build`). It is the ONLY NEXT_PUBLIC_
# variable in this template; secrets must never use a NEXT_PUBLIC_ name.
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"