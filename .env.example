# HKTutor shared development/demo project
# Copy this file to .env, replace every bracketed placeholder locally, and never commit .env.

# Prisma/NestJS database connection for S1-T04. Use the Supavisor session-mode URL (port 5432).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[DB_REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Server-only Supabase access for API/Storage work. Never expose the secret to Next.js.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_[REPLACE_ME]"

# Both buckets must be pre-created and private. Avatars are normalized to WebP.
SUPABASE_AVATAR_BUCKET="[AVATAR_BUCKET]"
SUPABASE_DOCUMENT_BUCKET="[DOCUMENT_BUCKET]"

# Local demo accounts. Public registration must never create an administrator.
SEED_ADMIN_EMAIL="[ADMIN_EMAIL]"
SEED_ADMIN_PASSWORD="[ADMIN_PASSWORD_AT_LEAST_10_CHARACTERS]"

SEED_TUTOR_EMAIL="[TUTOR_EMAIL]"
SEED_TUTOR_PASSWORD="[TUTOR_PASSWORD_AT_LEAST_10_CHARACTERS]"

SEED_STUDENT_EMAIL="[STUDENT_EMAIL]"
SEED_STUDENT_PASSWORD="[STUDENT_PASSWORD_AT_LEAST_10_CHARACTERS]"

# HKTutor JWT authentication. Generate two different random secrets of at least 32 characters.
JWT_ACCESS_SECRET="[JWT_ACCESS_SECRET_AT_LEAST_32_CHARACTERS]"
JWT_REFRESH_SECRET="[JWT_REFRESH_SECRET_AT_LEAST_32_CHARACTERS]"
JWT_ISSUER="hktutor-api"
JWT_AUDIENCE="hktutor-web"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Resend authentication emails. EMAIL_FROM must use a sender/domain authorized by Resend.
RESEND_API_KEY="[RESEND_API_KEY]"
EMAIL_FROM="HKTutor <no-reply@[VERIFIED_DOMAIN]>"
EMAIL_VERIFICATION_TTL_MINUTES="60"
PASSWORD_RESET_TTL_MINUTES="30"

# Browser, CORS, and refresh-cookie settings. Use HTTPS and COOKIE_SECURE=true in a deployed demo.
APP_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""

# Server-only NestJS origin used by the Next.js development rewrite. In Compose, the gateway sends
# /api/v1 directly to the API service and the web image uses http://api:3001 as its internal default.
API_INTERNAL_URL="http://localhost:3001"

# Optional S3-T01 development socket proxy (pnpm dev:socket-proxy).
# Open http://localhost:3002 and set WEB_ORIGIN to that value on the API when using it.
CHAT_PROXY_PORT="3002"
WEB_INTERNAL_URL="http://127.0.0.1:3000"

PAYMENT_PROVIDER="omise"
OMISE_SECRET_KEY="skey_test_REPLACE_ME"
OMISE_WEBHOOK_SECRET="REPLACE_ME"
# PAYMENT_PROVIDER supports only omise. Omise PromptPay Test Mode only. Both values are server-only; never use NEXT_PUBLIC_.
# OMISE_SECRET_KEY: Test Dashboard -> Keys (skey_test_...).
# OMISE_WEBHOOK_SECRET: Test Dashboard -> Webhooks (Base64 signing secret, not the API key).
# Both may be omitted to disable payments. Configure the public HTTPS webhook URL in Omise.
