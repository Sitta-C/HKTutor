# HKTutor shared development/demo project
# Copy this file to .env, replace every bracketed placeholder locally, and never commit .env.

# Prisma/NestJS database connection for S1-T04. Use the Supavisor session-mode URL (port 5432).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[DB_REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Server-only Supabase access for later API/Storage work. Never expose the secret to Next.js.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_[REPLACE_ME]"

# Local demo accounts. Public registration must never create an administrator.
SEED_ADMIN_EMAIL="[ADMIN_EMAIL]"
SEED_ADMIN_PASSWORD="[ADMIN_PASSWORD_AT_LEAST_10_CHARACTERS]"

SEED_TUTOR_EMAIL="[TUTOR_EMAIL]"
SEED_TUTOR_PASSWORD="[TUTOR_PASSWORD_AT_LEAST_10_CHARACTERS]"

# HKTutor JWT authentication. Generate two different random secrets of at least 32 characters.
JWT_ACCESS_SECRET="[JWT_ACCESS_SECRET_AT_LEAST_32_CHARACTERS]"
JWT_REFRESH_SECRET="[JWT_REFRESH_SECRET_AT_LEAST_32_CHARACTERS]"
JWT_ISSUER="hktutor-api"
JWT_AUDIENCE="hktutor-web"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Resend email verification. EMAIL_FROM must use a sender/domain authorized by Resend.
RESEND_API_KEY="[RESEND_API_KEY]"
EMAIL_FROM="HKTutor <no-reply@[VERIFIED_DOMAIN]>"
EMAIL_VERIFICATION_TTL_MINUTES="60"

# Browser, CORS, and refresh-cookie settings. Use HTTPS and COOKIE_SECURE=true in a deployed demo.
APP_URL="http://localhost:3000"
WEB_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""

# Public base URL of the NestJS API. The web client bakes this NEXT_PUBLIC_ value into its
# production build; secrets must never use a NEXT_PUBLIC_ name.
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001"
