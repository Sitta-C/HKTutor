# Railway terminates public TLS. Only this gateway needs a public domain.
events {}

# Error messages may contain a verification/reset URL. Keep them out of routine logs.
error_log /dev/stderr crit;

http {
    log_format hktutor '$request_method $uri $status';
    access_log /var/log/nginx/access.log hktutor;

    # Resolve upstreams per request and refresh DNS after an independent service redeploy.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;

    map $http_upgrade $chat_connection {
        default upgrade;
        '' close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        https https;
        http http;
    }

    server {
        listen ${PORT};
        listen [::]:${PORT};

        # The API allows documents up to 5 MiB plus multipart metadata.
        client_max_body_size 6m;

        set $api_upstream "${API_INTERNAL_URL}";
        set $web_upstream "${WEB_INTERNAL_URL}";

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $chat_connection;

        location ^~ /api/v1/ {
            # Preserve the complete Socket.IO path, encoded segments and query string.
            proxy_pass $api_upstream$request_uri;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
            proxy_buffering off;
        }

        location / {
            proxy_pass $web_upstream$request_uri;
        }
    }
}
